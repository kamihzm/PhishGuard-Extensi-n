{
  "name": "phishguard",
  "version": "0.1.1",
  "private": true,
  "description": "Extension de navegador (Manifest V3) que detecta posibles sitios de phishing analizando la URL visitada.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx ../tools/webProtection/compile.ts && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "wp:fetch": "tsx ../tools/webProtection/fetchSources.ts",
    "wp:compile": "tsx ../tools/webProtection/compile.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
